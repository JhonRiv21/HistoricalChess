---
// About: what counts as a world championship, how the analysis works, and every photo credit.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { credit } from '../lib/images';
import { pick, t, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const photos = (await getCollection('photos')).sort((a, b) => (a.data.year ?? 0) - (b.data.year ?? 0));
const copy = {
  es: {
    title: 'Sobre el sitio',
    lineageTitle: 'Qué cuenta como campeonato del mundo',
    lineage: 'Seguimos el linaje del título desde el primer match oficial, Steinitz contra Zukertort en 1886. Entre 1993 y 2006 el título estuvo dividido: incluimos los matches de las dos líneas (PCA/clásica y FIDE) y los torneos de 2005 y 2007. Los torneos eliminatorios de la FIDE entre 1998 y 2004 aparecen en la línea de tiempo, pero sin sus cientos de partidas.',
    engineTitle: 'Cómo se analizan las partidas',
    engine: 'Cada posición se evaluó con Stockfish 17.1 a profundidad 18, mirando las dos mejores continuaciones. La probabilidad de ganar y la precisión usan las fórmulas públicas de Lichess. El motor es una referencia moderna: los campeones de otras épocas no tenían computadoras para preparar.',
    classes: [
      ['!!', 'Brillante', 'la mejor jugada, la única buena (la siguiente opción pierde al menos 15 puntos de probabilidad), deja al menos una pieza menor en juego, no es jaque ni jugada de rey y la posición no estaba decidida. También la jugada célebre de cada partida del memorial, si el motor no la considera un error. Sale más o menos una cada nueve partidas.'],
      ['!', 'Gran jugada', 'la mejor jugada cuando la siguiente opción pierde al menos 12 puntos, sin ser una respuesta obligada a un jaque ni una recaptura.'],
      ['★', 'Mejor jugada', 'la que elige el motor.'],
      ['', 'Excelente y buena', 'pierden menos de 2 y de 5 puntos de probabilidad de ganar.'],
      ['?!', 'Imprecisión', 'pierde entre 5 y 10 puntos.'],
      ['?', 'Error', 'pierde entre 10 y 15 puntos.'],
      ['??', 'Error grave', 'pierde 15 puntos o más.'],
    ],
    classesTitle: 'Cómo se clasifican las jugadas',
    gamesTitle: 'De dónde salen las partidas',
    games: 'Las partidas vienen de pgnmentor.com y de los estudios de Lichess. Revisamos los resultados contra Wikipedia, Mark Weeks y Edward Winter; cuando una fuente se equivocaba, la corregimos y lo dejamos anotado en la partida.',
    photosTitle: 'Créditos de las fotos',
    photosIntro: 'Todas las fotos tienen licencia libre y vienen de Wikimedia Commons. Las del Nationaal Archief neerlandés (Anefo) son de dominio público.',
    noAds: 'Este sitio no tiene anuncios ni registro, y no usa cookies. Contamos visitas e interacciones de forma anónima con Umami, que no guarda datos personales; si tu navegador pide «No rastrear», no se cuenta nada.',
  },
  en: {
    title: 'About',
    lineageTitle: 'What counts as a world championship',
    lineage: 'We follow the title lineage from the first official match, Steinitz versus Zukertort in 1886. Between 1993 and 2006 the title was split: we include the matches of both lines (PCA/classical and FIDE) and the 2005 and 2007 tournaments. FIDE’s knockout events of 1998–2004 appear on the timeline without their hundreds of games.',
    engineTitle: 'How games are analyzed',
    engine: 'Every position was evaluated with Stockfish 17.1 at depth 18, looking at the two best continuations. Winning chances and accuracy use Lichess’s public formulas. The engine is a modern yardstick: champions of earlier eras had no computers to prepare with.',
    classes: [
      ['!!', 'Brilliant', 'the best move and the only good one (the next option loses at least 15 points of winning chances), leaves at least a minor piece hanging, is neither a check nor a king move, and the position was not already decided. Also the famous move of each memorial game, unless the engine calls it an error. About one every nine games.'],
      ['!', 'Great move', 'the best move when the next option loses at least 12 points, and not a forced reply to a check or a recapture.'],
      ['★', 'Best move', 'the engine’s choice.'],
      ['', 'Excellent and good', 'lose less than 2 and 5 points of winning chances.'],
      ['?!', 'Inaccuracy', 'loses 5 to 10 points.'],
      ['?', 'Mistake', 'loses 10 to 15 points.'],
      ['??', 'Blunder', 'loses 15 points or more.'],
    ],
    classesTitle: 'How moves are classified',
    gamesTitle: 'Where the games come from',
    games: 'Games come from pgnmentor.com and Lichess studies. Results were checked against Wikipedia, Mark Weeks and Edward Winter; when a source was wrong we corrected it and noted it on the game.',
    photosTitle: 'Photo credits',
    photosIntro: 'Every photo is freely licensed and comes from Wikimedia Commons. Those from the Dutch National Archives (Anefo) are in the public domain.',
    noAds: 'This site has no ads and no sign-up, and it uses no cookies. Visits and interactions are counted anonymously with Umami, which stores no personal data; if your browser sends Do Not Track, nothing is counted.',
  },
}[lang];
---

<BaseLayout {lang} title={copy.title} description={copy.lineage} altPath={lang === 'es' ? '/en/about/' : '/es/sobre/'}>
  <div class="view">
    <article class="section prose">
      <h1 class="section-title">{copy.title}</h1>
      <p>{copy.noAds}</p>
      <h2>{copy.lineageTitle}</h2>
      <p>{copy.lineage}</p>
      <h2>{copy.engineTitle}</h2>
      <p>{copy.engine}</p>
      <h2>{copy.classesTitle}</h2>
      <dl class="class-list">
        {copy.classes.map(([glyph, name, text]) => <div><dt><b>{glyph}</b> {name}</dt><dd>{text}</dd></div>)}
      </dl>
      <h2>{copy.gamesTitle}</h2>
      <p>{copy.games}</p>
      <h2>{copy.photosTitle}</h2>
      <p>{copy.photosIntro}</p>
      <ul class="credits-list">
        {photos.map((p) => <li>{pick(p.data.caption, lang)} {credit(p)}. <a href={p.data.sourceUrl} target="_blank" rel="noopener">Commons</a></li>)}
      </ul>
      <p>{t(lang, 'footer.credits')}</p>
    </article>
  </div>
</BaseLayout>
