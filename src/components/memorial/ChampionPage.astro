---
// One champion: portrait, biography, title matches and the best games of their career.
import { Picture } from 'astro:assets';
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { championUrl, championsUrl, hasMemorialAnalysis, memorialGameUrl, resultText, type Champion } from '../../lib/champions';
import { getMatches, matchUrl, photoAsset } from '../../lib/content';
import { pick, t, type Lang } from '../../i18n/ui';

interface Props { lang: Lang; champion: Champion }
const { lang, champion } = Astro.props;
const d = champion.data;
const other: Lang = lang === 'es' ? 'en' : 'es';
const photo = await getEntry(d.photo);
const titleMatches = (await getMatches()).filter((m) => d.matches.includes(m.id));
const lifespan = d.died ? `${d.born.slice(0, 4)}–${d.died.slice(0, 4)}` : `${t(lang, 'memorial.born')} ${d.born.slice(0, 4)}`;
---

<BaseLayout {lang} title={d.name} description={pick(d.bio, lang)} altPath={championUrl(other, champion.id)}>
  <div class="view">
    <nav class="crumbs" aria-label="breadcrumb"><a href={championsUrl(lang)}>{t(lang, 'memorial.allChampions')}</a> / {d.short}</nav>
    <header class="champion-head">
      <div class="champion-portrait" transition:name={`champion-${champion.id}`}>
        {photo && <Picture src={photoAsset(photo.data.file)} formats={['avif', 'webp']} widths={[360, 640]} sizes="(max-width: 820px) 90vw, 30vw" alt={pick(photo.data.alt, lang)} style={`object-position:${photo.data.focus}`} loading="eager" />}
      </div>
      <div class="champion-intro">
        <span class="lineup-reign">{t(lang, 'hero.champion')} {pick(d.reign, lang)}</span>
        <h1 class="lineup-title">{d.name}</h1>
        <span class="lineup-country">{pick(d.country, lang)}, {lifespan}</span>
        <p class="lede">{pick(d.bio, lang)}</p>
        <p><strong>{t(lang, 'memorial.style')}:</strong> {pick(d.style, lang)}</p>
        {photo && <p class="video-meta">{photo.data.author}, {photo.data.license}</p>}
      </div>
    </header>

    <section class="section">
      <h2 class="section-title">{t(lang, 'memorial.bestGames')}</h2>
      <ol class="memorial-games">
        {d.games.map((g) => (
          <li class="moment memorial-game">
            <span class="moment-round">{pick(g.event, lang)}, {g.date.slice(0, 4)}</span>
            <h3 class="moment-title">{pick(g.title, lang)}</h3>
            <p class="video-meta">{g.white} – {g.black}, {resultText(g.result)}</p>
            <p>{pick(g.story, lang)}</p>
            {hasMemorialAnalysis(champion.id, g.id) && <a class="btn" href={memorialGameUrl(lang, champion.id, g.id)}>{t(lang, 'memorial.playGame')}</a>}
          </li>
        ))}
      </ol>
    </section>

    {titleMatches.length > 0 && (
      <section class="section">
        <h2 class="section-title">{t(lang, 'memorial.titleMatches')}</h2>
        <ul class="match-links">
          {titleMatches.map((m) => <li><a class="btn" href={matchUrl(lang, m.id)}>{m.data.year}: {m.data.players.map((p) => p.short).join(' – ')}</a></li>)}
        </ul>
      </section>
    )}

    <section class="section">
      <h2 class="section-title">{t(lang, 'match.sources')}</h2>
      <ul class="credits-list">
        {[...d.sources, ...d.games.flatMap((g) => g.sources)].filter((s, i, all) => all.findIndex((x) => x.url === s.url) === i)
          .map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}
      </ul>
    </section>
  </div>
</BaseLayout>
