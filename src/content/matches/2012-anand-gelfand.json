  "moments": [
    {
      "id": "gelfand-gana",
      "round": 7,
      "title": {
        "es": "Gelfand toma la delantera",
        "en": "Gelfand takes the lead"
      },
      "text": {
        "es": "Con blancas, Gelfand aprovechó el error 23…g5 de Anand y ganó la primera partida decisiva del match.",
        "en": "With White, Gelfand pounced on Anand's mistake 23...g5 and won the first decisive game of the match."
      }
    },
    {
      "id": "diecisiete",
      "round": 8,
      "ply": 33,
      "title": {
        "es": "Diecisiete jugadas",
        "en": "Seventeen moves"
      },
      "text": {
        "es": "Al día siguiente, Gelfand se equivocó en la jugada 14 y pasó por alto 17.Df2 de Anand, que atrapó su dama. Fue la partida decisiva más corta en la historia de los mundiales.",
        "en": "The next day Gelfand went wrong on move 14 and overlooked Anand's 17.Qf2, which trapped his queen. It was the shortest decisive game in World Championship history."
      }
    },
    {
      "id": "rapidas",
      "round": 14,
      "title": {
        "es": "La única victoria del desempate",
        "en": "The only win of the playoff"
      },
      "text": {
        "es": "En el desempate, Anand jugó tan rápido que dejó a Gelfand con muy poco tiempo. Ganó la segunda partida con blancas y empató las otras tres.",
        "en": "In the playoff Anand played so fast that he left Gelfand very short of time. He won the second game with White and drew the other three."
      }
    }
  ],
  "facts": [
    {
      "text": {
        "es": "La partida 8, de solo 17 jugadas, es la partida decisiva más corta en la historia del Campeonato del Mundo.",
        "en": "Game 8, only 17 moves long, is the shortest decisive game in World Championship history."
      },
      "source": {
        "label": "Wikipedia",
