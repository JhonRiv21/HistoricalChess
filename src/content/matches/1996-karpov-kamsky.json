  "facts": [
    {
      "text": {
        "es": "Fue el primer campeonato de la FIDE tras la división de 1993; Kasparov y Short no participaron en ese ciclo.",
        "en": "It was the first FIDE championship after the 1993 split; Kasparov and Short did not take part in that cycle."
      },
      "source": {
        "label": "Wikipedia",
        "url": "https://en.wikipedia.org/wiki/FIDE_World_Chess_Championship_1996"
      }
    },
    {
      "text": {
        "es": "A diferencia de los ciclos anteriores, el campeón no pasó directo al match final: Karpov entró en la tercera ronda del torneo de candidatos.",
        "en": "Unlike earlier cycles, the champion did not go straight to the final match: Karpov joined the Candidates event in its third round."
      },
      "source": {
        "label": "Wikipedia",
        "url": "https://en.wikipedia.org/wiki/FIDE_World_Chess_Championship_1996"
      }
    },
    {
      "text": {
        "es": "Karpov tenía 45 años y Kamsky 22.",
        "en": "Karpov was 45 and Kamsky 22."
      },
      "source": {
        "label": "Wikipedia",
        "url": "https://en.wikipedia.org/wiki/FIDE_World_Chess_Championship_1996"
      }
    },
    {
      "text": {
        "es": "En el camino a la final, Kamsky eliminó a Viswanathan Anand y a Valeri Salov.",
        "en": "On his way to the final, Kamsky knocked out Viswanathan Anand and Valery Salov."
      },
