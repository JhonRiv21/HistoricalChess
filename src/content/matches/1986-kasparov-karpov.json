  "moments": [
    {
      "id": "bandera-caida",
      "title": {
        "es": "La bandera cae",
        "en": "The flag falls"
      },
      "text": {
        "es": "En la octava partida, Kasparov sacrificó un peón para atacar. Karpov, con un minuto en el reloj, cometió un error y su bandera cayó dos jugadas después.",
        "en": "In game eight Kasparov sacrificed a pawn to attack. Karpov, with one minute on his clock, blundered and his flag fell two moves later."
      },
      "round": 8
    },
    {
      "id": "ataque-total",
      "title": {
        "es": "Ataque total",
        "en": "All-out attack"
      },
      "text": {
        "es": "En la partida 16, Kasparov abandonó el flanco de dama, dejó un caballo varado en a3 y fue con todo contra el rey de Karpov. Ganó y se puso 9½–6½; casi todos dieron el match por decidido.",
        "en": "In game 16 Kasparov abandoned the queenside, left a knight stranded on a3 and went all out against Karpov's king. He won to lead 9½–6½, and nearly everyone considered the match decided."
      },
      "round": 16
    },
    {
      "id": "tres-seguidas",
      "title": {
        "es": "Tres seguidas de Karpov",
        "en": "Three in a row for Karpov"
      },
      "text": {
        "es": "Karpov ganó las partidas 17, 18 y 19 y empató 9½–9½. Después, Kasparov acusó a su segundo Evgeny Vladimirov de vender sus análisis a Karpov y lo despidió; Karpov negó cualquier espionaje.",
        "en": "Karpov won games 17, 18 and 19 to level at 9½–9½. Afterwards Kasparov accused his second Evgeny Vladimirov of selling his analysis to Karpov and dismissed him; Karpov denied any spying."
      },
      "round": 19
    },
    {
      "id": "la-22",
      "title": {
        "es": "La partida 22",
        "en": "Game 22"
      },
      "text": {
        "es": "Kasparov selló su jugada 41 cuando casi todos esperaban un final de torres difícil de ganar, pero encontró una línea preciosa sin defensa. Karpov abandonó a pocas jugadas de reanudar.",
        "en": "Kasparov sealed his 41st move when most observers expected a rook ending that would be hard to win, but he found a beautiful line with no defence. Karpov resigned a few moves into the second session."
      },
      "round": 22
    }
  ],
  "facts": [
    {
      "text": {
        "es": "La primera ministra británica Margaret Thatcher hizo el sorteo de colores en Londres.",
        "en": "British Prime Minister Margaret Thatcher made the draw for colours in London."
      },
      "source": {
        "label": "Mark Weeks: 1986 Kasparov - Karpov Highlights",
        "url": "https://www.mark-weeks.com/chess/86kk$$.htm"
      }
    },
    {
      "text": {
        "es": "Los dos jugadores donaron su parte de la bolsa de Londres a las víctimas de Chernóbil.",
        "en": "Both players donated their share of the London prize fund to the victims of Chernobyl."
      },
      "source": {
        "label": "Mark Weeks: 1986 Kasparov - Karpov Highlights",
        "url": "https://www.mark-weeks.com/chess/86kk$$.htm"
      }
    },
    {
      "text": {
        "es": "La partida 11 ganó un premio de belleza de 10 000 libras esterlinas, que se repartió entre los dos jugadores.",
        "en": "Game 11 won a brilliancy prize of 10,000 pounds sterling, which was split between the two players."
      },
      "source": {
        "label": "Mark Weeks: 1986 Kasparov - Karpov Highlights",
        "url": "https://www.mark-weeks.com/chess/86kk$$.htm"
      }
    },
    {
      "text": {
        "es": "Las partidas 1 a 12 se jugaron en el Park Lane Hotel de Londres y las 13 a 24 en el Hotel Leningrado.",
        "en": "Games 1–12 were played at the Park Lane Hotel in London and games 13–24 at the Hotel Leningrad."
      },
      "source": {
        "label": "Wikipedia: World Chess Championship 1986",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1986"
      }
    }
