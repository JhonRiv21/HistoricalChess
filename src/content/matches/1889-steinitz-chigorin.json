  "moments": [
    {
      "id": "trampa-de-steinitz",
      "title": {
        "es": "Una pieza atrapada",
        "en": "A piece in a trap"
      },
      "text": {
        "es": "En la cuarta partida, Steinitz jugó 10.a3!: el alfil negro quedó sin una retirada buena y Steinitz ganó material.",
        "en": "In game 4, Steinitz played 10.a3!, leaving Black's bishop with no good retreat, and won material."
      },
      "round": 4,
      "ply": 19
    },
    {
      "id": "descuido-de-chigorin",
      "title": {
        "es": "Un descuido que cuesta caro",
        "en": "A costly oversight"
      },
      "text": {
        "es": "En la quinta partida, Chigorin jugó 18.h3?? sin ver que su peón de f2 estaba clavado, y Steinitz ganó la partida con negras.",
        "en": "In game 5, Chigorin played 18.h3?? overlooking that his f2-pawn was pinned, and Steinitz won with Black."
      },
      "round": 5,
      "ply": 35
    },
    {
      "id": "sacrificio-de-torre",
      "title": {
        "es": "El sacrificio de torre",
        "en": "The rook sacrifice"
      },
      "text": {
        "es": "En la décima partida, Steinitz entregó una torre con 25.Txe7! para dejar expuesto al rey negro; Chigorin abandonó dos jugadas después.",
        "en": "In game 10, Steinitz gave up a rook with 25.Rxe7! to expose Black's king; Chigorin resigned two moves later."
      },
      "round": 10,
      "ply": 49
    }
  ],
  "facts": [
    {
      "text": {
        "es": "La bolsa total fue de 1.150 dólares, el premio más pequeño de todos los campeonatos del mundo.",
        "en": "The total purse was $1,150, the smallest prize fund of any world championship."
      },
      "source": {
        "label": "Wikipedia",
