  "moments": [
    {
      "id": "tal-pega-primero",
      "title": {
        "es": "Tal pega primero",
        "en": "Tal strikes first"
      },
      "text": {
        "es": "Tal ganó la primera partida con blancas y ya no dejó de ir adelante en el marcador.",
        "en": "Tal won the first game with White and was never behind or level again."
      },
      "round": 1
    },
    {
      "id": "caballo-en-f4",
      "title": {
        "es": "El caballo de f4",
        "en": "The knight on f4"
      },
      "text": {
        "es": "En la sexta partida, Tal dejó un caballo en f4 a cambio de iniciativa, un sacrificio especulativo. El público se alborotó tanto que la partida se trasladó a una sala del fondo por el ruido. Tal la ganó.",
        "en": "In game six Tal left a knight en prise on f4 in exchange for the initiative, a speculative sacrifice. The audience became so excited that the game was moved to a back room because of the noise. Tal won it."
      },
      "round": 6,
      "ply": 42
    },
    {
      "id": "la-memorable-f4",
      "title": {
        "es": "La «memorable» f4",
        "en": "The \"memorable\" f4"
      },
      "text": {
        "es": "La partida 17 fue una victoria de Tal en 41 jugadas. Tal calificó su 12.f4 de «memorable»: creía que desconcertaría a Botvinnik.",
        "en": "Game 17 was a 41-move win for Tal. Tal described his 12.f4 as \"memorable\": he believed it would throw Botvinnik off."
      },
      "round": 17
    },
    {
      "id": "campeon-con-tablas",
      "title": {
        "es": "Campeón con unas tablas",
        "en": "Champion with a draw"
      },
      "text": {
        "es": "Botvinnik abandonó la partida 19 sin reanudarla tras el aplazamiento. Dos tablas después, en la partida 21, Tal llegó a 12½ y fue el nuevo campeón.",
        "en": "Botvinnik resigned game 19 without resuming it after adjournment. Two draws later, in game 21, Tal reached 12½ and was the new champion."
      },
      "round": 21
    }
  ],
  "facts": [
    {
      "text": {
        "es": "En el torneo de candidatos de 1959, Tal hizo 14½ puntos de 16 contra los cuatro últimos, incluidas cuatro victorias en cuatro partidas contra un Bobby Fischer de 16 años.",
        "en": "In the 1959 Candidates tournament, Tal scored 14½ out of 16 against the bottom four, including four wins in four games against a 16-year-old Bobby Fischer."
      },
      "source": {
        "label": "Wikipedia: World Chess Championship 1960",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1960"
      }
    },
    {
      "text": {
        "es": "Botvinnik era favorito porque Tal había tenido resultados menos brillantes contra los mejores, incluidas tres derrotas ante Paul Keres en el torneo de candidatos.",
        "en": "Botvinnik was the favourite because Tal's results against the very best were less impressive, including three losses to Paul Keres in the Candidates tournament."
      },
      "source": {
        "label": "Wikipedia: World Chess Championship 1960",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1960"
      }
    },
    {
      "text": {
        "es": "Tal ganó seis partidas, Botvinnik dos y hubo trece tablas.",
        "en": "Tal won six games, Botvinnik two, and thirteen were drawn."
      },
      "source": {
        "label": "Mark Weeks: 1960 Tal - Botvinnik",
        "url": "https://www.mark-weeks.com/chess/58601wix.htm"
      }
    }
  ],
