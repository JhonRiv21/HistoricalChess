  "moments": [
    {
      "id": "primera-vuelta",
      "round": 7,
      "title": {
        "es": "Una primera vuelta histórica",
        "en": "A historic first half"
      },
      "text": {
        "es": "Topalov ganó seis de sus siete partidas de la primera vuelta. Solo Anand lo frenó en la segunda ronda, defendiendo con tenacidad un final de dama y peones que tenía perdido.",
        "en": "Topalov won six of his seven first-half games. Only Anand stopped him, in round two, by tenaciously defending a lost queen-and-pawn ending."
      }
    },
    {
      "id": "titulo-asegurado",
      "round": 51,
      "title": {
        "es": "Título asegurado",
        "en": "Title secured"
      },
      "text": {
        "es": "Con unas tablas ante Kasimdzhanov en la ronda 13, Topalov se aseguró el primer lugar con una ronda de anticipación.",
        "en": "With a draw against Kasimdzhanov in round 13, Topalov clinched first place with a round to spare."
      }
    }
  ],
  "facts": [
    {
      "text": {
        "es": "Judit Polgár fue la primera y, hasta hoy, la única mujer en jugar un Campeonato del Mundo de formato reducido, es decir, no un torneo por eliminación con más de cien jugadores.",
        "en": "Judit Polgár became the first and, to date, only woman to play in a small-format World Championship, meaning not a knockout with over a hundred players."
      },
      "source": {
        "label": "Wikipedia",
        "url": "https://en.wikipedia.org/wiki/FIDE_World_Chess_Championship_2005"
