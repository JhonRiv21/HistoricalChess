  "moments": [
    {
      "id": "golpe-y-respuesta",
      "title": {
        "es": "Golpe y respuesta",
        "en": "Blow and counterblow"
      },
      "text": {
        "es": "Botvinnik ganó la primera partida y Tal la segunda. Después el excampeón ganó cinco de las nueve siguientes, contra una sola de Tal, y tomó una ventaja que ya no soltó.",
        "en": "Botvinnik won the first game and Tal the second. Then the former champion won five of the next nine, against just one for Tal, and took a lead he never gave up."
      },
      "round": 2
    },
    {
      "id": "maraton-de-121",
      "title": {
        "es": "Maratón de 121 jugadas",
        "en": "A 121-move marathon"
      },
      "text": {
        "es": "La partida 20 terminó en tablas después de 121 jugadas. Fue la partida más larga de la historia de los campeonatos del mundo hasta 1978.",
        "en": "Game 20 ended in a draw after 121 moves. It was the longest game in world championship history until 1978."
      },
      "round": 20
    },
    {
      "id": "tercera-corona",
      "title": {
        "es": "La tercera corona",
        "en": "The third crown"
      },
      "text": {
        "es": "Botvinnik ganó la partida 21, llegó a 13 puntos y recuperó el título por segunda vez.",
        "en": "Botvinnik won game 21, reached 13 points and regained the title for the second time."
      },
      "round": 21
    }
  ],
  "facts": [
    {
      "text": {
        "es": "En 2002, Yuri Averbakh reveló que los médicos de Riga le aconsejaron a Tal postergar el match por su salud. Botvinnik solo aceptaba aplazarlo si médicos de Moscú lo declaraban no apto, y Tal decidió jugar convencido de que igual ganaría.",
        "en": "In 2002 Yuri Averbakh revealed that Tal's doctors in Riga advised him to postpone the match for health reasons. Botvinnik would only agree if Moscow doctors certified him unfit, and Tal decided to play, thinking he would win anyway."
      },
      "source": {
        "label": "Wikipedia: World Chess Championship 1961",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1961"
      }
    },
    {
      "text": {
        "es": "Con 49 años, Botvinnik es el jugador de más edad en ganar un match por el campeonato del mundo desde que Steinitz, con 55, venció a Chigorin en 1892.",
        "en": "At 49, Botvinnik is the oldest player to win a world championship match since 55-year-old Steinitz beat Chigorin in 1892."
      },
      "source": {
        "label": "Wikipedia: World Chess Championship 1961",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1961"
      }
    },
    {
      "text": {
        "es": "Las 121 jugadas de la partida 20 fueron récord en los campeonatos del mundo hasta la quinta partida de Karpov–Korchnoi en 1978.",
        "en": "The 121 moves of game 20 were a world championship record until game five of Karpov–Korchnoi in 1978."
      },
      "source": {
        "label": "Wikipedia: World Chess Championship 1978",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1978"
      }
    },
    {
      "text": {
        "es": "Botvinnik ganó diez partidas, Tal cinco y hubo seis tablas.",
        "en": "Botvinnik won ten games, Tal five, and six were drawn."
      },
      "source": {
        "label": "Mark Weeks: 1961 Botvinnik - Tal",
        "url": "https://www.mark-weeks.com/chess/58602wix.htm"
      }
    }
  ],
