  "moments": [
    {
      "id": "anand-golpea",
      "round": 9,
      "title": {
        "es": "Anand golpea primero",
        "en": "Anand strikes first"
      },
      "text": {
        "es": "Tras ocho tablas seguidas, Anand, con blancas, rompió la defensa siciliana Scheveningen de Kasparov y se puso adelante.",
        "en": "After eight straight draws, Anand, with White, broke through Kasparov's Sicilian Scheveningen and took the lead."
      }
    },
    {
      "id": "respuesta",
      "round": 10,
      "title": {
        "es": "La respuesta inmediata",
        "en": "The immediate reply"
      },
      "text": {
        "es": "Al día siguiente, Kasparov empató el marcador con una novedad en la Apertura Española, variante abierta.",
        "en": "The next day Kasparov levelled the score with a new idea in the Open Variation of the Ruy Lopez."
      }
    },
    {
      "id": "dragon",
      "round": 11,
      "title": {
        "es": "La sorpresa del Dragón",
        "en": "The Dragon surprise"
      },
      "text": {
        "es": "Kasparov sorprendió a Anand con el Dragón siciliano, una defensa que entonces casi nadie usaba en la élite. Anand pasó por alto una combinación relativamente sencilla y perdió; muchos ven aquí el punto de quiebre del match.",
        "en": "Kasparov surprised Anand with the Sicilian Dragon, a defence hardly anyone played at the top level back then. Anand missed a fairly simple combination and lost; many see this as the turning point of the match."
      }
    },
    {
      "id": "decidido",
      "round": 14,
      "title": {
        "es": "Match decidido",
        "en": "Match decided"
      },
      "text": {
        "es": "Con su victoria en la partida 14, Kasparov se puso 8½–5½. Las cuatro partidas restantes fueron tablas.",
        "en": "With his win in game 14 Kasparov led 8½–5½. The last four games were all drawn."
      }
    }
  ],
