  "moments": [
    {
      "id": "arranque",
      "round": 4,
      "title": {
        "es": "Un arranque fulminante",
        "en": "A blistering start"
      },
      "text": {
        "es": "Kasparov ganó las partidas 1, 3 y 4. Tras solo cuatro rondas mandaba 3½–½ y el match quedó prácticamente encaminado.",
        "en": "Kasparov won games 1, 3 and 4. After only four rounds he led 3½–½, and the match was all but settled."
      }
    },
    {
      "id": "victoria-short",
      "round": 16,
      "title": {
        "es": "La única victoria de Short",
        "en": "Short's only win"
      },
      "text": {
        "es": "En la partida 16, con blancas, Short por fin le ganó una partida al campeón. Fue su único triunfo en todo el match.",
        "en": "In game 16, playing White, Short finally beat the champion. It was his only win of the whole match."
      }
    },
    {
      "id": "exhibiciones",
      "title": {
        "es": "Exhibiciones para llenar el calendario",
        "en": "Exhibition games to fill the schedule"
      },
      "text": {
        "es": "Como el match terminó antes de lo previsto, los dos jugadores llenaron los días que quedaban con siete partidas de exhibición. Kasparov también las ganó, 5–2.",
        "en": "Because the match ended early, the two players filled the remaining days with seven exhibition games. Kasparov won those too, 5–2."
      }
    }
  ],
  "facts": [
    {
      "text": {
        "es": "Kasparov y Short acusaron a la FIDE de corrupción y falta de profesionalismo, y fundaron la PCA para organizar el match por su cuenta.",
        "en": "Kasparov and Short accused FIDE of corruption and a lack of professionalism, and founded the PCA to run the match themselves."
      },
      "source": {
        "label": "Wikipedia",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1993"
      }
    },
    {
      "text": {
        "es": "El organizador, Raymond Keene, llevó el match a Londres; la FIDE lo había planeado en Mánchester.",
        "en": "Organizer Raymond Keene brought the match to London; FIDE had planned to hold it in Manchester."
      },
      "source": {
        "label": "Wikipedia",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1993"
      }
    },
    {
      "text": {
        "es": "El canal británico Channel 4 emitió unos 81 programas sobre el match, y Short llegó a aparecer en comerciales de cerveza en televisión.",
        "en": "Britain's Channel 4 broadcast some 81 programmes on the match, and Short even appeared in TV beer commercials."
      },
      "source": {
        "label": "Wikipedia",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1993"
      }
    },
    {
      "text": {
        "es": "En respuesta, la FIDE despojó a Kasparov del título y sacó a ambos jugadores de sus listas de rating.",
        "en": "In response, FIDE stripped Kasparov of his title and removed both players from its rating lists."
      },
      "source": {
        "label": "Wikipedia",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1993"
      }
    }
