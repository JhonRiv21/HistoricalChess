  "moments": [
    {
      "id": "mal-comienzo",
      "title": {
        "es": "Mal comienzo",
        "en": "A bad start"
      },
      "text": {
        "es": "Petrosian ganó la primera partida con negras y el retador empezó abajo.",
        "en": "Petrosian won the first game with Black and the challenger started behind."
      },
      "round": 1
    },
    {
      "id": "dos-seguidas",
      "title": {
        "es": "Dos seguidas",
        "en": "Two in a row"
      },
      "text": {
        "es": "Spassky ganó las partidas 4 y 5 y se puso adelante. Ganó también la 8 y llegó a sacar dos puntos de ventaja.",
        "en": "Spassky won games 4 and 5 to turn the score around. He also won game 8 and opened a two-point lead."
      },
      "round": 5
    },
    {
      "id": "ataque-en-la-19",
      "title": {
        "es": "Ataque en la 19",
        "en": "The attack in game 19"
      },
      "text": {
        "es": "En la partida 19, Spassky avanzó su peón g para lanzar un ataque contra el rey de Petrosian y ganó en 24 jugadas.",
        "en": "In game 19 Spassky pushed his g-pawn to launch an attack on Petrosian's king and won in 24 moves."
      },
      "round": 19
    },
    {
      "id": "decimo-campeon",
      "title": {
        "es": "El décimo campeón",
        "en": "The tenth champion"
      },
      "text": {
        "es": "Con unas tablas en la partida 23, Spassky llegó a 12½ puntos y le quitó el título a Petrosian.",
        "en": "With a draw in game 23, Spassky reached 12½ points and took the title from Petrosian."
      },
      "round": 23
    }
  ],
  "facts": [
    {
      "text": {
        "es": "Fue la segunda vez seguida que Petrosian y Spassky jugaron por el título.",
        "en": "It was the second consecutive time Petrosian and Spassky played for the title."
      },
      "source": {
        "label": "Wikipedia: World Chess Championship 1969",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1969"
      }
    },
    {
      "text": {
        "es": "Para llegar al match, Spassky venció a Efim Geller y a Bent Larsen, ambos por 5½–2½, y luego a Viktor Korchnoi en la final de candidatos.",
        "en": "To reach the match, Spassky beat Efim Geller and Bent Larsen, both 5½–2½, and then Viktor Korchnoi in the Candidates final."
      },
      "source": {
        "label": "Wikipedia: Boris Spassky",
        "url": "https://en.wikipedia.org/wiki/Boris_Spassky"
      }
    },
    {
      "text": {
        "es": "En el Interzonal de Sousse 1967, Bobby Fischer iba primero con siete victorias y tres tablas, pero abandonó el torneo tras una disputa con los organizadores.",
        "en": "At the 1967 Sousse Interzonal, Bobby Fischer was leading with seven wins and three draws, but walked out after a dispute with the organisers."
      },
      "source": {
        "label": "Wikipedia: World Chess Championship 1969",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1969"
      }
    },
    {
      "text": {
        "es": "La flexibilidad de estilo de Spassky se considera la clave de su victoria sobre Petrosian.",
        "en": "Spassky's flexibility of style is considered the key to his victory over Petrosian."
      },
      "source": {
        "label": "Wikipedia: Boris Spassky",
        "url": "https://en.wikipedia.org/wiki/Boris_Spassky"
      }
    }
