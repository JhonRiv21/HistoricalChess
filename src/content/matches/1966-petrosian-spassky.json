  "moments": [
    {
      "id": "seis-tablas",
      "title": {
        "es": "Seis tablas para empezar",
        "en": "Six draws to begin"
      },
      "text": {
        "es": "Las seis primeras partidas terminaron en tablas, un récord para el inicio de un campeonato del mundo que duró hasta 1978.",
        "en": "The first six games were drawn, a record start for a world championship that stood until 1978."
      },
      "round": 6
    },
    {
      "id": "petrosian-ataca",
      "title": {
        "es": "Petrosian ataca",
        "en": "Petrosian attacks"
      },
      "text": {
        "es": "El campeón, famoso por su defensa, ganó las partidas 7 y 10 con un estilo de ataque y sacrificios. Spassky diría que la ventaja de Petrosian era que sus rivales nunca sabían cuándo iba a jugar de repente como Mikhail Tal.",
        "en": "The champion, famous for his defence, won games 7 and 10 in an attacking, sacrificial style. Spassky would say that Petrosian's advantage was that his opponents never knew when he would suddenly play like Mikhail Tal."
      },
      "round": 10
    },
    {
      "id": "titulo-asegurado",
      "title": {
        "es": "Título asegurado",
        "en": "Title secured"
      },
      "text": {
        "es": "Con su victoria en la partida 22, Petrosian se puso 12–10 y ya no podía perder el título. Aun así, los dos jugaron las dos partidas restantes.",
        "en": "With his win in game 22, Petrosian led 12–10 and could no longer lose the title. Even so, both players played the remaining two games."
      },
      "round": 22
    },
    {
      "id": "victoria-tardia",
      "title": {
        "es": "Una victoria tardía",
        "en": "A late win"
      },
      "text": {
        "es": "Spassky ganó la partida 23, su tercera victoria del match, cuando Petrosian ya había asegurado la corona.",
        "en": "Spassky won game 23, his third win of the match, after Petrosian had already secured the crown."
      },
      "round": 23
    }
  ],
  "facts": [
    {
      "text": {
        "es": "Tras la polémica de Curazao, el ciclo de 1966 fue el primero en elegir al retador con matches eliminatorios en lugar de un torneo.",
        "en": "After the Curaçao controversy, the 1966 cycle was the first to choose the challenger through knockout matches instead of a tournament."
      },
      "source": {
        "label": "Wikipedia: World Chess Championship 1966",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1966"
      }
    },
    {
      "text": {
        "es": "Fue el primer match desde 1934 en que el campeón venció a su retador; Botvinnik había retenido el título en 1951 y 1954 con empates.",
        "en": "It was the first match since 1934 in which the champion beat his challenger; Botvinnik had kept the title in 1951 and 1954 with tied matches."
      },
      "source": {
        "label": "Wikipedia: World Chess Championship 1966",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1966"
      }
    },
    {
      "text": {
        "es": "Petrosian ganó cuatro partidas, Spassky tres y hubo diecisiete tablas.",
        "en": "Petrosian won four games, Spassky three, and seventeen were drawn."
      },
      "source": {
        "label": "Wikipedia: Boris Spassky",
        "url": "https://en.wikipedia.org/wiki/Boris_Spassky"
      }
    },
    {
      "text": {
        "es": "Las seis tablas del comienzo fueron récord hasta que Karpov y Korchnoi empezaron su match de 1978 con siete.",
        "en": "The six opening draws were a record until Karpov and Korchnoi began their 1978 match with seven."
      },
      "source": {
        "label": "Wikipedia: World Chess Championship 1978",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1978"
      }
    }
  ],
