  "moments": [
    {
      "id": "cinco-a-cero",
      "title": {
        "es": "Cinco a cero",
        "en": "Five to nil"
      },
      "text": {
        "es": "Karpov ganó cuatro de las nueve primeras partidas y la 27. Con 5–0 en victorias, le faltaba solo una para retener el título.",
        "en": "Karpov won four of the first nine games and game 27. At 5–0 in wins, he needed just one more to keep the title."
      },
      "round": 27
    },
    {
      "id": "primera-de-kasparov",
      "title": {
        "es": "La primera de Kasparov",
        "en": "Kasparov's first win"
      },
      "text": {
        "es": "En la partida 32, Kasparov consiguió por fin su primera victoria. Siguieron catorce tablas seguidas.",
        "en": "In game 32 Kasparov finally scored his first win. Fourteen draws in a row followed."
      },
      "round": 32
    },
    {
      "id": "dos-seguidas",
      "title": {
        "es": "Dos seguidas",
        "en": "Two in a row"
      },
      "text": {
        "es": "Kasparov ganó la partida 47 el 31 de enero y la 48 el 8 de febrero, ya en una nueva sede. Karpov, que llevaba tres meses sin ganar, se veía agotado.",
        "en": "Kasparov won game 47 on 31 January and game 48 on 8 February, by then at a new venue. Karpov, without a win for three months, looked exhausted."
      },
      "round": 48
    },
    {
      "id": "match-suspendido",
      "title": {
        "es": "Match suspendido",
        "en": "Match stopped"
      },
      "text": {
        "es": "Campomanes dio por terminado el match sin resultado y anunció uno nuevo. La decisión fue polémica: no había precedentes, y ambos jugadores dijeron luego que preferían seguir.",
        "en": "Campomanes ended the match without a result and announced a new one. The decision was controversial: there was no precedent, and both players later said they would have preferred to continue."
      }
    }
  ],
  "facts": [
    {
      "text": {
        "es": "El récord anterior de duración de un match por el título era de 34 partidas, en Capablanca–Alekhine de 1927, que también era a seis victorias.",
        "en": "The previous record length for a title match was 34 games, in Capablanca–Alekhine 1927, which was also a first-to-six-wins match."
      },
      "source": {
        "label": "Wikipedia: World Chess Championship 1984–1985",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1984"
      }
    },
    {
      "text": {
        "es": "El match se jugó en el Salón de las Columnas de la Casa de los Sindicatos, pero el contrato de la sala venció y hubo que mudarse al Hotel Sport.",
        "en": "The match was played in the Hall of Columns of the House of the Unions, but the lease ran out and play had to move to the Sport Hotel."
      },
      "source": {
        "label": "Wikipedia: World Chess Championship 1984–1985",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1984"
      }
    },
    {
      "text": {
        "es": "El árbitro principal fue el gran maestro yugoslavo Svetozar Gligorić.",
        "en": "The chief arbiter was Yugoslav grandmaster Svetozar Gligorić."
      },
      "source": {
        "label": "Wikipedia: World Chess Championship 1984–1985",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1984"
      }
    },
    {
      "text": {
        "es": "Sigue siendo el primer y único campeonato del mundo suspendido sin resultado.",
        "en": "It remains the first and only world championship called off without a result."
      },
      "source": {
        "label": "Wikipedia: World Chess Championship 1984–1985",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1984"
      }
    },
    {
      "text": {
        "es": "La decisión de Campomanes contribuyó a que Kasparov rompiera más tarde con la FIDE y fundara la Professional Chess Association.",
        "en": "Campomanes's decision contributed to Kasparov later breaking with FIDE and founding the Professional Chess Association."
      },
      "source": {
        "label": "Wikipedia: World Chess Championship 1984–1985",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1984"
      }
    }
  ],
