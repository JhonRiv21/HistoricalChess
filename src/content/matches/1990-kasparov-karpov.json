  "moments": [
    {
      "id": "la-bandera-rusa",
      "title": {
        "es": "La bandera rusa",
        "en": "The Russian flag"
      },
      "text": {
        "es": "Aunque seguía siendo ciudadano soviético, Kasparov se negó a jugar bajo la bandera de la URSS y quiso usar la tricolor rusa, en apoyo a Boris Yeltsin. Karpov protestó.",
        "en": "Although still a Soviet citizen, Kasparov refused to play under the USSR flag and wanted the Russian tricolour instead, in support of Boris Yeltsin. Karpov protested."
      }
    },
    {
      "id": "102-jugadas",
      "title": {
        "es": "Una partida de 102 jugadas",
        "en": "A 102-move game"
      },
      "text": {
        "es": "La partida 16 rompió una larga racha de tablas. Se aplazó dos veces; el equipo de Kasparov encontró la victoria antes de reanudarla y Karpov abandonó en la jugada 102.",
        "en": "Game 16 broke a long run of draws. It was adjourned twice; Kasparov's team found the win before resumption and Karpov resigned on move 102."
      },
      "round": 16,
      "ply": 203
    },
    {
      "id": "ataque-espectacular",
      "title": {
        "es": "Un ataque espectacular",
        "en": "A spectacular attack"
      },
      "text": {
        "es": "En la partida 20, Kasparov sacrificó un peón y luego un alfil, y con todas sus piezas apuntando al rey de Karpov ganó con un ataque espectacular. Se puso 11–9.",
        "en": "In game 20 Kasparov sacrificed a pawn and then a bishop, and with all his pieces aimed at Karpov's king he won with a spectacular attack. He led 11–9."
      },
      "round": 20
    },
    {
      "id": "jaque-perpetuo",
      "title": {
        "es": "Un jaque perpetuo para el título",
        "en": "Perpetual check for the title"
      },
      "text": {
        "es": "En la partida 22, Kasparov forzó un jaque perpetuo y se aseguró la corona por otros tres años.",
        "en": "In game 22 Kasparov forced perpetual check and made sure of the crown for another three years."
      },
      "round": 22
    }
  ],
  "facts": [
    {
      "text": {
        "es": "Kasparov llegó al match con 2800 de Elo, un récord en ese momento.",
        "en": "Kasparov came into the match rated 2800, a record at the time."
      },
      "source": {
        "label": "Wikipedia: World Chess Championship 1990",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1990"
      }
    },
    {
      "text": {
        "es": "Karpov propuso que, si el match terminaba 12–12, siguieran jugando hasta la primera partida decisiva; Kasparov no aceptó.",
        "en": "Karpov proposed that, if the match ended 12–12, they play on until the first decisive game; Kasparov declined."
      },
      "source": {
        "label": "Wikipedia: World Chess Championship 1990",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1990"
      }
    },
    {
      "text": {
        "es": "En Nueva York se jugó en el Hudson Theater, de 750 butacas, y las jugadas se mostraban en un tablero electrónico de unos 4,5 metros.",
        "en": "In New York it was played in the 750-seat Hudson Theater, with moves shown on a 15-foot electronic demonstration board."
      },
      "source": {
        "label": "Mark Weeks: 1990 Kasparov - Karpov Highlights",
        "url": "https://www.mark-weeks.com/chess/90kk$$.htm"
      }
    },
    {
      "text": {
        "es": "La bolsa fue de 3 millones de dólares, con cinco octavos para el ganador.",
        "en": "The prize fund was 3 million US dollars, with five-eighths going to the winner."
      },
      "source": {
        "label": "Mark Weeks: 1990 Kasparov - Karpov Highlights",
        "url": "https://www.mark-weeks.com/chess/90kk$$.htm"
      }
    }
