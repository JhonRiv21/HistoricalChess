  "moments": [
    {
      "id": "tropiezo-inicial",
      "title": {
        "es": "Tropiezo inicial",
        "en": "An early stumble"
      },
      "text": {
        "es": "Botvinnik ganó la primera partida, jugada el 23 de marzo de 1963, con negras.",
        "en": "Botvinnik won the first game, played on 23 March 1963, with Black."
      },
      "round": 1
    },
    {
      "id": "petrosian-toma-el-mando",
      "title": {
        "es": "Petrosian toma el mando",
        "en": "Petrosian takes charge"
      },
      "text": {
        "es": "Petrosian ganó las partidas 5 y 7 y se puso adelante. Botvinnik lo igualó en la 14, pero Petrosian ganó la 15 y no volvió a quedar atrás.",
        "en": "Petrosian won games 5 and 7 and went ahead. Botvinnik levelled in game 14, but Petrosian won game 15 and never trailed."
      },
      "round": 7
    },
    {
      "id": "el-cierre",
      "title": {
        "es": "El cierre",
        "en": "The finish"
      },
      "text": {
        "es": "Tras ganar las partidas 18 y 19, a Petrosian le bastaba con entablar las tres últimas. La final, el 20 de mayo, terminó en tablas y le dio los 12½ puntos.",
        "en": "After winning games 18 and 19, Petrosian only had to draw the last three. The final game, on 20 May, was drawn and gave him the 12½ points."
      },
      "round": 22
    }
  ],
  "facts": [
    {
      "text": {
        "es": "Después de las acusaciones de tablas pactadas en Curazao 1962, la FIDE reemplazó el torneo de candidatos por matches eliminatorios, un formato que se usó hasta 2013.",
        "en": "After the allegations of pre-arranged draws at Curaçao 1962, FIDE replaced the Candidates tournament with knockout matches, a format used until 2013."
      },
      "source": {
        "label": "Wikipedia: World Chess Championship 1963",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1963"
      }
    },
    {
      "text": {
        "es": "Las reglas habían cambiado: a diferencia de 1957 y 1960, el campeón derrotado ya no tenía derecho a revancha. Botvinnik dejó la lucha por el título, aunque siguió jugando.",
        "en": "The rules had changed: unlike in 1957 and 1960, the defeated champion no longer had a right to a rematch. Botvinnik left title play, though he kept playing chess."
      },
      "source": {
        "label": "Wikipedia: World Chess Championship 1963",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1963"
      }
    },
    {
      "text": {
        "es": "A Petrosian lo apodaban «Tigran de Hierro» por su estilo defensivo casi impenetrable.",
        "en": "Petrosian was nicknamed \"Iron Tigran\" for his almost impenetrable defensive style."
      },
      "source": {
        "label": "Wikipedia: Tigran Petrosian",
        "url": "https://en.wikipedia.org/wiki/Tigran_Petrosian"
      }
    },
    {
      "text": {
        "es": "En Curazao, Petrosian entabló sus cinco últimas partidas y aun así ganó el torneo.",
        "en": "At Curaçao, Petrosian drew his last five games and still won the tournament."
      },
      "source": {
        "label": "Wikipedia: World Chess Championship 1963",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1963"
      }
    }
  ],
