  "moments": [
    {
      "id": "anand-iguala",
      "round": 3,
      "title": {
        "es": "La revancha de la preparación",
        "en": "Preparation pays off"
      },
      "text": {
        "es": "En un Gambito de Dama, Anand mejoró una partida anterior entre Aronian y Adams y obtuvo una ventaja clara. Carlsen, con seis minutos en el reloj, se equivocó con 28…Aa5 y Anand empató el match.",
        "en": "In a Queen's Gambit Declined, Anand improved on an earlier Aronian–Adams game and got a clear advantage. Carlsen, down to six minutes, erred with 28...Ba5, and Anand levelled the match."
      }
    },
    {
      "id": "doble-error",
      "round": 6,
      "ply": 52,
      "title": {
        "es": "Un doble error",
        "en": "A double blunder"
      },
      "text": {
        "es": "Carlsen jugó 26.Rd2, un error que Anand podía castigar con 26…Cxe5. Anand no lo vio, respondió rápido con 26…a4 y Carlsen ya no dio otra oportunidad.",
        "en": "Carlsen played 26.Kd2, a blunder Anand could have punished with 26...Nxe5. Anand missed it, quickly replied 26...a4, and Carlsen gave him no further chances."
      }
    },
    {
      "id": "sacrificio",
      "round": 11,
      "ply": 54,
      "title": {
        "es": "Un riesgo que no salió",
        "en": "A gamble that didn't pay off"
      },
      "text": {
        "es": "Anand sacrificó una calidad con 27…Tb4 para buscar juego activo. Él mismo admitió después que fue un riesgo injustificado; Carlsen ganó la partida y el match.",
        "en": "Anand gave up the exchange with 27...Rb4 in search of active play. He later admitted it was an unjustified risk; Carlsen won the game and the match."
      }
    }
  ],
  "facts": [
    {
      "text": {
        "es": "La victoria de Anand en la partida 3 fue su único triunfo sobre Carlsen en los dos matches por el título que jugaron.",
        "en": "Anand's win in game 3 was his only victory over Carlsen across their two title matches."
      },
