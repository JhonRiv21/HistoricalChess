  "facts": [
    {
      "text": {
        "es": "En San Petersburgo 1895–96, Steinitz terminó segundo detrás de Lasker y por delante de Harry Pillsbury y Mikhail Chigorin.",
        "en": "At St. Petersburg 1895–96, Steinitz finished second behind Lasker and ahead of Harry Pillsbury and Mikhail Chigorin."
      },
      "source": {
        "label": "Wikipedia",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1896–1897"
      }
    },
    {
      "text": {
        "es": "Las dos únicas victorias de Steinitz llegaron seguidas, en las partidas 12 y 13.",
        "en": "Steinitz's only two wins came back to back, in games 12 and 13."
      },
      "source": {
        "label": "Mark Weeks",
        "url": "https://www.mark-weeks.com/chess/z6ls$wix.htm"
      }
    },
    {
      "text": {
        "es": "No hubo otro campeonato del mundo hasta 1907, en parte porque Lasker se dedicó a su doctorado en matemáticas.",
        "en": "There was no other world championship until 1907, partly because Lasker devoted himself to his doctorate in mathematics."
      },
      "source": {
        "label": "Wikipedia",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1907"
      }
    },
    {
      "text": {
        "es": "A comienzos de 1896, Steinitz había ganado un match al ruso Emanuel Schiffers con 6 victorias, 4 derrotas y 1 tablas.",
        "en": "Earlier in 1896, Steinitz had beaten Russia's Emanuel Schiffers in a match with 6 wins, 4 losses and 1 draw."
      },
      "source": {
        "label": "Wikipedia (Wilhelm Steinitz)",
