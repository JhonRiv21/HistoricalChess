  "moments": [
    {
      "id": "arranque-de-botvinnik",
      "title": {
        "es": "Arranque del campeón",
        "en": "The champion's fast start"
      },
      "text": {
        "es": "Botvinnik ganó las partidas 1, 2 y 4, aunque varias veces salió de la apertura con peor posición. Tras seis partidas iba 4½–1½.",
        "en": "Botvinnik won games 1, 2 and 4, even though he often came out of the opening with the worse position. After six games he led 4½–1½."
      },
      "round": 4
    },
    {
      "id": "tres-seguidas",
      "title": {
        "es": "Tres victorias seguidas",
        "en": "Three wins in a row"
      },
      "text": {
        "es": "Smyslov ganó la séptima partida y luego la 9, la 10 y la 11. Con eso se puso adelante por primera vez, 6–5.",
        "en": "Smyslov won game seven and then games 9, 10 and 11. That put him ahead for the first time, 6–5."
      },
      "round": 11
    },
    {
      "id": "partida-en-television",
      "title": {
        "es": "La partida que se vio por televisión",
        "en": "The game on television"
      },
      "text": {
        "es": "La partida 12 fue la primera de un campeonato del mundo transmitida por televisión. Botvinnik la ganó y volvió a igualar el marcador.",
        "en": "Game 12 was the first world championship game ever broadcast on television. Botvinnik won it and levelled the score again."
      },
      "round": 12
    },
    {
      "id": "tablas-final",
      "title": {
        "es": "Tablas en la última",
        "en": "A draw in the last game"
      },
      "text": {
        "es": "Smyslov ganó la partida 23 y llegó a la última empatado 11½–11½, pero necesitaba ganar. En la 24 ofreció tablas en la jugada 22, la partida más corta del match, y Botvinnik retuvo el título.",
        "en": "Smyslov won game 23 and reached the last game level at 11½–11½, but he needed a win. In game 24 he offered a draw on move 22, the shortest game of the match, and Botvinnik kept his title."
      },
      "round": 24
    }
  ],
  "facts": [
    {
      "text": {
        "es": "El match se inauguró el 16 de marzo en la Sala de Conciertos Chaikovski, ante unos 2000 espectadores.",
        "en": "The match opened on 16 March at the Tchaikovsky Concert Hall, in front of some 2,000 spectators."
      },
      "source": {
        "label": "Wikipedia: World Chess Championship 1954",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1954"
      }
    },
    {
      "text": {
        "es": "El público era tan ruidoso que a mitad del match se instaló en la sala un cartel de «Silencio, por favor».",
        "en": "The crowds were so noisy that a \"Silence, please\" sign was put up in the hall halfway through the match."
      },
      "source": {
        "label": "Wikipedia: World Chess Championship 1954",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1954"
      }
    },
    {
      "text": {
        "es": "El interés era tal que Harry Golombek, de British Chess Magazine, contó que la fila para conseguir entradas medía media milla, unos 800 metros.",
        "en": "Interest was so high that Harry Golombek of British Chess Magazine reported the queue for tickets was half a mile long."
      },
      "source": {
        "label": "Wikipedia: World Chess Championship 1954",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1954"
      }
    },
    {
      "text": {
        "es": "Cada jugador ganó siete partidas y hubo diez tablas.",
        "en": "Each player won seven games and there were ten draws."
      },
      "source": {
        "label": "Mark Weeks: 1954 Botvinnik - Smyslov",
        "url": "https://www.mark-weeks.com/chess/5254$wix.htm"
      }
    }
  ],
