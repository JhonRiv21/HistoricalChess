  "moments": [
    {
      "id": "euwe-arranca",
      "title": {
        "es": "Euwe arranca mejor",
        "en": "Euwe starts stronger"
      },
      "text": {
        "es": "Euwe ganó la primera y la quinta partida y, tras cinco juegos, iba un punto arriba.",
        "en": "Euwe won games 1 and 5 and, after five games, was a point ahead."
      },
      "round": 5
    },
    {
      "id": "racha-de-alekhine",
      "title": {
        "es": "La racha de Alekhine",
        "en": "Alekhine's surge"
      },
      "text": {
        "es": "Entre las partidas 6 y 10, Alekhine sumó 4½ de 5 puntos y tomó una ventaja de tres puntos.",
        "en": "Between games 6 and 10, Alekhine scored 4½ out of 5 and took a three-point lead."
      },
      "round": 10
    },
    {
      "id": "titulo-recuperado",
      "title": {
        "es": "El título vuelve a Alekhine",
        "en": "The title returns to Alekhine"
      },
      "text": {
        "es": "Euwe recortó la diferencia a dos puntos, pero desde la partida 21 Alekhine ganó cuatro de las últimas cinco y con la victoria en la 25 recuperó la corona.",
        "en": "Euwe cut the gap to two points, but from game 21 Alekhine won four of the last five, and his win in game 25 brought back the crown."
      },
      "round": 25
    }
  ],
  "facts": [
    {
      "text": {
        "es": "El contrato de 1935 le daba a Alekhine el derecho a una revancha si perdía el título, y él lo usó.",
        "en": "The 1935 contract gave Alekhine the right to a rematch if he lost the title, and he used it."
      },
      "source": {
        "label": "Wikipedia (neerlandés)",
        "url": "https://nl.wikipedia.org/wiki/Wereldkampioenschap_schaken_1937"
      }
    },
    {
      "text": {
        "es": "Fue el último campeonato del mundo en que el campeón controlaba el título y fijaba las condiciones. Tras la muerte de Alekhine en 1946, la FIDE tomó el control.",
        "en": "It was the last world championship in which the champion controlled the title and set the conditions. After Alekhine's death in 1946, FIDE took over."
      },
      "source": {
        "label": "Wikipedia",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1937"
      }
    },
    {
      "text": {
        "es": "Para preparar la revancha, Alekhine dejó el alcohol, aunque más tarde volvió a beber.",
        "en": "To prepare for the rematch, Alekhine gave up alcohol, although he later started drinking again."
      },
      "source": {
        "label": "Wikipedia (Max Euwe)",
        "url": "https://en.wikipedia.org/wiki/Max_Euwe"
      }
    },
    {
      "text": {
        "es": "Euwe perdió cuatro de las últimas cinco partidas.",
        "en": "Euwe lost four of the last five games."
      },
      "source": {
        "label": "Wikipedia (Max Euwe)",
        "url": "https://en.wikipedia.org/wiki/Max_Euwe"
      }
    },
    {
      "text": {
        "es": "Las partidas de Ámsterdam se jugaron en el hotel Krasnapolsky.",
        "en": "The Amsterdam games were played at the Krasnapolsky hotel."
      },
      "source": {
        "label": "Wikipedia (neerlandés)",
        "url": "https://nl.wikipedia.org/wiki/Wereldkampioenschap_schaken_1937"
      }
    }
  ],
