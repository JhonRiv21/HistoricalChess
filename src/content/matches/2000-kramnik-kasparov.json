  "moments": [
    {
      "id": "berlinesa",
      "round": 1,
      "title": {
        "es": "El muro de Berlín",
        "en": "The Berlin Wall"
      },
      "text": {
        "es": "Desde la primera partida, Kramnik respondió al 1.e4 de Kasparov con la Defensa Berlinesa de la Apertura Española, para la que el campeón no estaba preparado.",
        "en": "From the very first game, Kramnik met Kasparov's 1.e4 with the Berlin Defence of the Ruy Lopez, which the champion was not ready for."
      }
    },
    {
      "id": "grunfeld",
      "round": 2,
      "title": {
        "es": "Golpe en la Grünfeld",
        "en": "A blow in the Grünfeld"
      },
      "text": {
        "es": "Kramnik ganó con blancas usando una idea nueva contra la Defensa Grünfeld, la favorita de Kasparov, que había descubierto entrenando con Boris Gelfand un año antes.",
        "en": "Kramnik won with White using a new idea against Kasparov's favourite Grünfeld Defence, which he had found while training with Boris Gelfand a year earlier."
      }
    },
    {
      "id": "decima",
      "round": 10,
      "title": {
        "es": "La segunda victoria",
        "en": "The second win"
      },
      "text": {
        "es": "Kramnik ganó la décima partida gracias al conocimiento profundo de una variante que habían estudiado sus segundos, Joël Lautier y Evgeny Bareev.",
        "en": "Kramnik won game 10 thanks to deep knowledge of a line studied by his seconds, Joël Lautier and Evgeny Bareev."
      }
    }
  ],
  "facts": [
    {
      "text": {
        "es": "Kasparov no ganó ninguna partida: Kramnik terminó con dos victorias, trece tablas y ninguna derrota.",
        "en": "Kasparov did not win a single game: Kramnik finished with two wins, thirteen draws and no losses."
      },
      "source": {
        "label": "Wikipedia",
        "url": "https://en.wikipedia.org/wiki/Classical_World_Chess_Championship_2000"
      }
    },
    {
      "text": {
        "es": "En 1998, Alexei Shirov le había ganado a Kramnik un match clasificatorio para enfrentar a Kasparov, pero ese match por el título nunca se concretó.",
        "en": "In 1998 Alexei Shirov had beaten Kramnik in a qualifying match to face Kasparov, but that title match never happened."
      },
      "source": {
        "label": "Wikipedia",
        "url": "https://en.wikipedia.org/wiki/Classical_World_Chess_Championship_2000"
      }
    },
    {
      "text": {
        "es": "Después de este match, la Defensa Berlinesa se volvió muy popular como arma sólida para las negras.",
        "en": "After this match the Berlin Defence became hugely popular as a solid weapon for Black."
      },
      "source": {
        "label": "Wikipedia",
        "url": "https://en.wikipedia.org/wiki/Classical_World_Chess_Championship_2000"
      }
    },
    {
      "text": {
        "es": "Se jugó en los estudios de televisión Riverside, en Hammersmith, con una bolsa de 2 millones de dólares.",
        "en": "It was played at the Riverside television studios in Hammersmith, with a prize fund of 2 million dollars."
      },
      "source": {
        "label": "Mark Weeks – World Chess Championship",
