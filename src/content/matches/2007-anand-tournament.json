  "facts": [
    {
      "text": {
        "es": "El torneo estaba organizado cuando se acordó el match de 2006; por eso se estableció que Kramnik ocuparía el lugar de Topalov si ganaba en Elistá.",
        "en": "The tournament was already organized when the 2006 match was agreed, so it was set that Kramnik would take Topalov's place if he won in Elista."
      },
      "source": {
        "label": "Wikipedia",
