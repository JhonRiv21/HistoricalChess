  "moments": [
    {
      "id": "arranque-rapido",
      "title": {
        "es": "Un arranque rápido",
        "en": "A quick start"
      },
      "text": {
        "es": "Alekhine ganó la primera partida, el 6 de septiembre, en solo 26 jugadas.",
        "en": "Alekhine won the first game, on 6 September, in just 26 moves."
      },
      "round": 1
    },
    {
      "id": "jaque-mate",
      "title": {
        "es": "Jaque mate sobre el tablero",
        "en": "Checkmate on the board"
      },
      "text": {
        "es": "En la octava partida, Alekhine sacrificó material para abrir el enroque blanco y terminó con 30...Th2#, un jaque mate real.",
        "en": "In game 8, Alekhine sacrificed material to break open White's king position and finished with 30...Rh2#, an actual checkmate."
      },
      "round": 8,
      "ply": 60
    },
    {
      "id": "seis-no-bastan",
      "title": {
        "es": "Seis victorias no bastaban",
        "en": "Six wins were not enough"
      },
      "text": {
        "es": "Tras la partida 12, Alekhine ya tenía seis victorias, pero solo 8 puntos: el reglamento también exigía más de 15, así que el match siguió.",
        "en": "After game 12, Alekhine already had six wins but only 8 points: the rules also required more than 15, so the match went on."
      },
      "round": 12
    },
    {
      "id": "cierre-con-tablas",
      "title": {
        "es": "Unas tablas para cerrar",
        "en": "A draw to finish"
      },
      "text": {
        "es": "Con las tablas de la partida 25, Alekhine llegó a 15½ puntos y retuvo el título.",
        "en": "With a draw in game 25, Alekhine reached 15½ points and kept the title."
      },
      "round": 25
    }
  ],
  "facts": [
    {
      "text": {
        "es": "Para ganar había que sumar seis victorias y además más de 15 puntos.",
        "en": "To win, a player needed six wins and also more than 15 points."
      },
      "source": {
        "label": "Wikipedia",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1929"
      }
    },
    {
      "text": {
        "es": "En Bad Kissingen 1928, Bogoljubov terminó por delante de Capablanca y de casi todos los grandes de la época; Alekhine no jugó ese torneo.",
        "en": "At Bad Kissingen 1928, Bogoljubov finished ahead of Capablanca and nearly every leading player of the day; Alekhine did not take part."
      },
      "source": {
        "label": "Wikipedia",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1929"
      }
    },
    {
      "text": {
        "es": "Alekhine también tenía una oferta para una revancha con Capablanca en Bradley Beach, Nueva Jersey, pero eligió a Bogoljubov.",
        "en": "Alekhine also had an offer for a rematch with Capablanca in Bradley Beach, New Jersey, but chose Bogoljubov."
      },
      "source": {
        "label": "Wikipedia",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1929"
      }
    },
    {
      "text": {
        "es": "La octava partida terminó con jaque mate en el tablero, 30...Th2#. En los campeonatos del mundo lo habitual es que el perdedor abandone antes.",
        "en": "Game 8 ended with checkmate on the board, 30...Rh2#. In world championships the loser almost always resigns before that."
      },
      "source": {
        "label": "Wikipedia",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_1929"
      }
    }
  ],
