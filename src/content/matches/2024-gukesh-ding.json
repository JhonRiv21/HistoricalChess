  "moments": [
    {
      "id": "ding-arranca",
      "round": 1,
      "title": {
        "es": "El campeón golpea primero",
        "en": "The champion strikes first"
      },
      "text": {
        "es": "Ding, que llegaba en el puesto 23 del ranking tras meses casi sin jugar, ganó la primera partida con negras.",
        "en": "Ding, ranked 23rd after months of barely playing, won the first game with Black."
      }
    },
    {
      "id": "ding-responde",
      "round": 12,
      "title": {
        "es": "La respuesta de Ding",
        "en": "Ding's reply"
      },
      "text": {
        "es": "Un día después de quedar abajo por la derrota en la partida 11, Ding ganó con blancas y empató el match 6–6.",
        "en": "A day after falling behind with his loss in game 11, Ding won with White and tied the match at 6–6."
      }
    },
    {
      "id": "tf2",
      "round": 14,
      "ply": 109,
      "title": {
        "es": "El error decisivo",
        "en": "The decisive blunder"
      },
      "text": {
        "es": "En un final de tablas teóricas, Ding ofreció cambiar torres con 55.Tf2 cuando su alfil estaba encerrado en una esquina. Gukesh pasó a un final de peones ganado y se coronó campeón.",
        "en": "In a theoretically drawn ending, Ding offered a rook trade with 55.Rf2 while his bishop was stuck in a corner. Gukesh went into a winning pawn ending and was crowned champion."
      }
    }
  ],
  "facts": [
    {
      "text": {
        "es": "Con 18 años, Gukesh se convirtió en el campeón mundial indiscutido más joven; solo Ruslan Ponomariov, campeón de la FIDE en 2002 en la época del título dividido, ganó un título siendo más joven.",
        "en": "At 18, Gukesh became the youngest undisputed world champion; only Ruslan Ponomariov, FIDE champion in 2002 during the split-title era, won a title at a younger age."
      },
      "source": {
        "label": "Wikipedia",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_2024"
      }
    },
    {
      "text": {
        "es": "Antes del match, Gukesh era quinto del ranking mundial con 2783 puntos y Ding era el número 23 con 2727.",
        "en": "Before the match Gukesh was ranked fifth in the world with 2783 and Ding 23rd with 2727."
      },
      "source": {
        "label": "Wikipedia",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_2024"
      }
    },
    {
      "text": {
        "es": "Tras ganar el título en 2023, Ding estuvo meses sin jugar torneos; luego contó que se debía al cansancio y a la depresión.",
        "en": "After winning the title in 2023 Ding stayed away from tournaments for months; he later said it was due to fatigue and depression."
      },
      "source": {
        "label": "Wikipedia",
        "url": "https://en.wikipedia.org/wiki/World_Chess_Championship_2024"
      }
    },
    {
      "text": {
        "es": "Gukesh recibió 1.350.000 dólares y Ding, 1.150.000.",
        "en": "Gukesh received 1,350,000 dollars and Ding 1,150,000."
      },
      "source": {
        "label": "Wikipedia",
